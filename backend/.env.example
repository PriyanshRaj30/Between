# Database
DATABASE_URL=postgresql+asyncpg://texie_user:texie_pass@localhost:5432/texie_db

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-this

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Two authorized users (set these during initial setup)
USER_A_USERNAME=user_a
USER_B_USERNAME=user_b

# Token expiry (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=86400
